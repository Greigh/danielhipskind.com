{
  "name": "adamas",
  "version": "1.0.0",
  "description": "Adamas - A powerful web application that assists call center agents with tasks that many have to use separate tools for, such as note taking, call summarization, and CRM integration.",
  "main": "src/main.js",
  "sideEffects": [
    "src/js/main.js"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:e2e": "npm run build && node test/e2e/run-e2e.js",
    "test:smoke": "node test/e2e/smoke-test.js",
    "dev": "NODE_OPTIONS='--no-deprecation' NODE_ENV=development node dev-server.js",
    "sass": "sass src/styles/main.scss:src/styles/main.css --style compressed",
    "sass:watch": "sass --watch src/styles/main.scss:src/styles/main.css",
    "build:webpack": "NODE_ENV=production npx webpack --mode production",
    "build:dev": "npm run build:webpack && node build.js",
    "build": "npm run clean && npm run build:webpack && node build.js",
    "clean": "node clean-build.js",
    "upload": "npm run build && sh upload.sh",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "server:dev": "PORT=8080 node --watch server.js",
    "dev:local": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "deploy": "bash scripts/deploy-with-site.sh",
    "deploy:skip-tests": "DEPLOY_SKIP_TESTS=1 bash scripts/deploy-with-site.sh",
    "test:security": "jest --runInBand test/security.helpers.test.js test/security.client.test.js test/http.security.smoke.test.js",
    "test:audit": "jest --runInBand test/security.helpers.test.js test/security.client.test.js test/memory.bounds.test.js test/legal.and.features.test.js test/http.security.smoke.test.js",
    "git:identity": "git config user.name Greigh && git config user.email dghipskind@gmail.com",
    "prepare": "npm run git:identity || true"
  },
  "author": "Daniel Hipskind aka Greigh",
  "license": "CC BY-NC-ND",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "http-proxy": "^1.18.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-middleware": "^8.5.0",
    "webpack-hot-middleware": "^2.26.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.4.0",
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.2.1",
    "openai": "^7.43.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "twilio": "^6.2.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.1",
    "nodemailer": "^10.2.1"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
